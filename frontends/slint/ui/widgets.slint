// Composants d'OpenHeadset Control, dessinés avec le thème (theme.slint).
//
// Règle commune : un contrôle n'affiche jamais une valeur que le casque n'a
// pas confirmée. Au clic, il garde l'état confirmé et montre « envoi en
// cours » (`pending`) jusqu'à ce que l'état relu change ou que l'envoi se
// termine (`busy` repasse à faux).

import { Spinner } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";

// Icône vectorielle (grille 24 × 24).
export component Icon inherits Path {
    in property <string> name;
    in property <brush> color: Theme.text;
    commands: root.name;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.color;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    width: 20px;
    height: 20px;
}

// Carte : surface arrondie, bordure discrète, ombre mesurée.
export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-large;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.shadow;
}

// Titre de carte : icône d'accent, titre, et contenu à droite (@children).
export component CardHeader inherits HorizontalLayout {
    in property <string> icon;
    in property <string> title;
    spacing: 12px;
    if root.icon != "": VerticalLayout {
        alignment: center;
        Icon {
            name: root.icon;
            color: Theme.accent;
            width: 24px;
            height: 24px;
        }
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.font-heading;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
    @children
}

// Petit texte secondaire.
export component Caption inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-small;
    wrap: word-wrap;
}

// Interrupteur. `checked` est l'état confirmé par le casque ; un clic
// demande l'autre valeur par `toggled` et affiche l'attente.
export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> busy;
    callback toggled(bool);
    private property <bool> pending;
    changed checked => {
        self.pending = false;
    }
    changed busy => {
        if !self.busy {
            self.pending = false;
        }
    }

    width: 48px;
    height: 28px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.accent : Theme.track;
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: Theme.quick; }
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled && !root.pending {
            root.pending = true;
            root.toggled(!root.checked);
        }
    }

    knob := Rectangle {
        width: 22px;
        height: 22px;
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        border-radius: self.height / 2;
        background: #ffffff;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000040;
        animate x { duration: Theme.smooth; easing: ease-out; }
        if root.pending: Spinner {
            x: 3px;
            y: 3px;
            width: 16px;
            height: 16px;
            indeterminate: true;
        }
    }
    TouchArea {
        enabled: root.enabled && !root.pending;
        mouse-cursor: pointer;
        clicked => {
            root.pending = true;
            root.toggled(!root.checked);
        }
    }
}

// Ligne de réglage : pastille d'icône, titre, description, contrôle à
// droite (@children).
export component SettingRow inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> subtitle;
    // Faux : réglage non lu ou non pris en charge, affiché comme tel.
    in property <bool> available: true;
    border-radius: Theme.radius;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.border;
    min-height: 68px;
    HorizontalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 12px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 11px;
                background: root.available ? Theme.accent-soft : Theme.surface-hover;
                Icon {
                    x: 9px;
                    y: 9px;
                    name: root.icon;
                    color: root.available ? Theme.accent-strong : Theme.text-faint;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.title;
                color: root.available ? Theme.text : Theme.text-muted;
                font-size: Theme.font-body;
                font-weight: 600;
                wrap: word-wrap;
            }
            if root.subtitle != "" || !root.available: Caption {
                text: root.available ? root.subtitle : "Indisponible : non lu sur ce casque";
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

// Ligne de réglage avec interrupteur.
export component ToggleRow inherits SettingRow {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> busy;
    callback toggled(bool);
    Toggle {
        checked: root.checked;
        enabled: root.enabled;
        busy: root.busy;
        accessible-label: root.title;
        toggled(v) => {
            root.toggled(v);
        }
    }
}

// Bouton : « primary » (accent), « secondary », « ghost », « danger ».
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> kind: "secondary";
    in property <bool> enabled: true;
    callback clicked;
    private property <color> ink: root.kind == "primary" ? Theme.accent-text : root.kind == "danger" ? Theme.danger : Theme.text;

    height: 40px;
    min-width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-small;
    background: root.kind == "primary" ? (touch.pressed ? Theme.accent-strong : Theme.accent) : root.kind == "danger" ? Theme.danger-soft : root.kind == "ghost" ? (touch.has-hover ? Theme.surface-hover : transparent) : (touch.has-hover ? Theme.surface-hover : Theme.surface-raised);
    border-width: root.kind == "secondary" ? 1px : 0px;
    border-color: Theme.border;
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    lay := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                color: root.ink;
                width: 18px;
                height: 18px;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.ink;
            font-size: Theme.font-body;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Grande tuile de mode (contrôle du bruit, mode audio).
export component ModeTile inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <bool> busy;
    // Petite fenêtre (choisi par la fenêtre, pas d'après la largeur de la
    // tuile, ce qui ferait une boucle de mise en page).
    in property <bool> compact;
    callback clicked;
    private property <bool> pending;
    changed selected => {
        self.pending = false;
    }
    changed busy => {
        if !self.busy {
            self.pending = false;
        }
    }

    min-height: 148px;
    min-width: 92px;
    horizontal-stretch: 1;
    border-radius: Theme.radius;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    background: root.selected ? Theme.accent-soft : touch.has-hover && root.enabled ? Theme.surface-hover : Theme.surface-raised;
    opacity: root.enabled ? 1 : 0.5;
    animate background, border-color { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: root.title;
    accessible-checked: root.selected;
    accessible-action-default => {
        if root.enabled && !root.selected {
            root.pending = true;
            root.clicked();
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: self.height / 2;
                background: root.selected ? Theme.accent : Theme.surface-hover;
                drop-shadow-blur: root.selected ? 18px : 0px;
                drop-shadow-color: Theme.accent.with-alpha(0.55);
                animate background { duration: Theme.smooth; }
                if !root.pending: Icon {
                    x: 15px;
                    y: 15px;
                    width: 26px;
                    height: 26px;
                    name: root.icon;
                    color: root.selected ? #ffffff : Theme.text;
                }
                if root.pending: Spinner {
                    x: 14px;
                    y: 14px;
                    width: 28px;
                    height: 28px;
                    indeterminate: true;
                }
            }
        }
        Text {
            text: root.title;
            color: Theme.text;
            // Petite fenêtre : texte plus petit plutôt que tronqué.
            font-size: root.compact ? Theme.font-small : Theme.font-body;
            font-weight: 600;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.text-muted;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    touch := TouchArea {
        enabled: root.enabled && !root.selected && !root.pending;
        mouse-cursor: pointer;
        clicked => {
            root.pending = true;
            root.clicked();
        }
    }
}

// Puce (préréglage, scène).
export component Chip inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked;
    height: 44px;
    min-width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: 12px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    background: root.selected ? Theme.accent-soft : touch.has-hover && root.enabled ? Theme.surface-hover : Theme.surface-raised;
    opacity: root.enabled ? 1 : 0.45;
    animate background, border-color { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    lay := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                color: root.selected ? Theme.accent-strong : Theme.text-muted;
                width: 18px;
                height: 18px;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Onglets segmentés (sous-pages, choix exclusifs).
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    in property <bool> enabled: true;
    callback selected(int);
    height: 42px;
    border-radius: 12px;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.border;
    opacity: root.enabled ? 1 : 0.5;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for item[i] in root.items: Rectangle {
            horizontal-stretch: 1;
            min-width: label.preferred-width + 24px;
            border-radius: 9px;
            background: root.current == i ? Theme.accent : touch.has-hover ? Theme.surface-hover : transparent;
            animate background { duration: Theme.quick; }
            accessible-role: tab;
            accessible-label: item;
            accessible-checked: root.current == i;
            label := Text {
                width: parent.width;
                height: parent.height;
                text: item;
                color: root.current == i ? Theme.accent-text : Theme.text-muted;
                font-size: Theme.font-body;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    root.selected(i);
                }
            }
        }
    }
}

// Curseur horizontal. La valeur n'est envoyée qu'au relâchement.
export component ThemedSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <bool> enabled: true;
    in-out property <float> value;
    callback released(float);
    private property <length> knob: 22px;
    private property <length> usable: root.width - root.knob;
    private property <float> ratio: (clamp(root.value, root.minimum, root.maximum) - root.minimum) / (root.maximum - root.minimum);

    pure function value-at(x: length) -> float {
        let raw = root.minimum + (x - root.knob / 2) / root.usable * (root.maximum - root.minimum);
        clamp(round(raw / root.step) * root.step, root.minimum, root.maximum)
    }

    height: 32px;
    min-width: 120px;
    horizontal-stretch: 1;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: slider;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;

    Rectangle {
        x: root.knob / 2;
        y: (root.height - 6px) / 2;
        width: root.usable;
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
    }
    Rectangle {
        x: root.knob / 2;
        y: (root.height - 6px) / 2;
        width: root.usable * root.ratio;
        height: 6px;
        border-radius: 3px;
        background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent-strong 100%);
    }
    Rectangle {
        x: root.usable * root.ratio;
        y: (root.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: #ffffff;
        border-width: focus.has-focus ? 3px : Theme.dark ? 0px : 2px;
        border-color: Theme.accent;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.accent.with-alpha(0.5);
    }
    // Sous la zone tactile, et sans prise du clic : sinon le premier
    // clic ne ferait que donner le focus, sans rien envoyer au casque.
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.value = min(root.maximum, root.value + root.step);
                root.released(root.value);
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.value = max(root.minimum, root.value - root.step);
                root.released(root.value);
                return accept;
            }
            reject
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                focus.focus();
                root.value = root.value-at(self.mouse-x);
            } else if event.kind == PointerEventKind.up {
                root.released(root.value);
            }
        }
        moved => {
            if self.pressed {
                root.value = root.value-at(self.mouse-x);
            }
        }
    }
}

// Entrée de la navigation latérale (libellé, ou icône seule en mode rail).
export component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> compact;
    callback clicked;
    height: 50px;
    border-radius: 12px;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.surface-hover : transparent;
    animate background { duration: Theme.quick; }
    accessible-role: tab;
    accessible-label: root.label;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.clicked();
    }
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.selected ? 24px : 0px;
        border-radius: 2px;
        background: Theme.accent;
        animate height { duration: Theme.smooth; easing: ease-out; }
    }
    HorizontalLayout {
        padding-left: root.compact ? 0px : 18px;
        spacing: 14px;
        alignment: root.compact ? center : start;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                color: root.selected ? Theme.accent-strong : Theme.text-muted;
                width: 22px;
                height: 22px;
            }
        }
        if !root.compact: Text {
            text: root.label;
            color: root.selected ? Theme.text : Theme.text-muted;
            font-size: 15px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Onglet de la navigation inférieure (petite fenêtre).
export component BottomTab inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    horizontal-stretch: 1;
    min-height: 60px;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.clicked();
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 30px;
                border-radius: 15px;
                background: root.selected ? Theme.accent-soft : transparent;
                animate background { duration: Theme.quick; }
                Icon {
                    x: 15px;
                    y: 4px;
                    name: root.icon;
                    color: root.selected ? Theme.accent-strong : Theme.text-muted;
                    width: 22px;
                    height: 22px;
                }
            }
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.text : Theme.text-muted;
            font-size: 11px;
            font-weight: root.selected ? 600 : 400;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Pastille d'état de la connexion.
export component StatusPill inherits Rectangle {
    in property <string> text;
    // 0 déconnecté, 1 recherche ou lecture en cours, 2 connecté.
    in property <int> level;
    height: 32px;
    min-width: lay.preferred-width;
    border-radius: 16px;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.border;
    lay := HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            if root.level != 1: Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: root.level == 2 ? Theme.success : Theme.text-faint;
                drop-shadow-blur: root.level == 2 ? 8px : 0px;
                drop-shadow-color: Theme.success;
            }
            if root.level == 1: Spinner {
                width: 14px;
                height: 14px;
                indeterminate: true;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Bandeau d'information ou d'alerte.
export component AlertBanner inherits Rectangle {
    in property <string> text;
    in property <bool> warning;
    border-radius: Theme.radius;
    background: root.warning ? Theme.danger-soft : Theme.accent-soft;
    border-width: 1px;
    border-color: root.warning ? Theme.danger.with-alpha(0.4) : Theme.accent.with-alpha(0.35);
    HorizontalLayout {
        padding: 12px;
        padding-left: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.warning ? Icons.warning : Icons.info;
                color: root.warning ? Theme.danger : Theme.accent-strong;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// Liste « libellé : valeur » sur fond de carte.
export component KeyValue inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> note;
    in property <bool> last;
    min-height: 44px;
    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.value;
                color: Theme.text;
                font-size: Theme.font-body;
                horizontal-alignment: right;
                wrap: word-wrap;
            }
            if root.note != "": Text {
                text: root.note;
                color: Theme.text-faint;
                font-size: 11px;
                horizontal-alignment: right;
                wrap: word-wrap;
            }
        }
    }
    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}
