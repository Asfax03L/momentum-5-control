// OpenHeadset Control : fenêtre principale et panneau rapide.
//
// Affichage seulement : tous les textes et décisions viennent du modèle de
// vue Rust (momentum-core/src/viewmodel.rs). Les actions remontent par des
// callbacks ; une valeur n'apparaît comme appliquée qu'une fois relue sur
// le casque.
//
// Disposition selon la largeur réelle de la fenêtre :
// - large (≥ 1100 px) : navigation latérale avec libellés, tableau de bord
//   sur deux colonnes ;
// - intermédiaire : navigation en rail (icônes), colonnes qui se replient ;
// - petite (< 720 px) : une colonne, navigation en bas de l'écran.

import { ComboBox, LineEdit, ScrollView, TextEdit, AboutSlint, Palette, Spinner } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, Card, CardHeader, Caption, Toggle, SettingRow, ToggleRow, ActionButton, ModeTile, Chip, Segmented, ThemedSlider, NavItem, BottomTab, StatusPill, AlertBanner, KeyValue } from "widgets.slint";
import { Band, EqualizerPanel } from "equalizer.slint";

export { Band, Theme }

export struct Row {
    label: string,
    value: string,
}

export struct HotkeyRow {
    label: string,
    spec: string,
}

// Information avec sa provenance et l'heure de lecture.
export struct InfoRow {
    label: string,
    value: string,
    source: string,
}

// Constat de la page « Connexion et audio ».
export struct Finding {
    problem: bool,
    text: string,
}

export struct ConnectionRow {
    name: string,
    status: string,
    action: string,
    can-act: bool,
}

// Liste « libellé : valeur ».
component RowList inherits VerticalLayout {
    in property <[Row]> rows;
    for r[i] in root.rows: KeyValue {
        label: r.label;
        value: r.value;
        last: i == root.rows.length - 1;
    }
}

// Liste « libellé : valeur », avec la source de chaque valeur.
component InfoList inherits VerticalLayout {
    in property <[InfoRow]> rows;
    for r[i] in root.rows: KeyValue {
        label: r.label;
        value: r.value;
        note: r.source;
        last: i == root.rows.length - 1;
    }
}

// Carte vide : casque absent ou fonction indisponible.
component EmptyState inherits Card {
    in property <string> title;
    in property <string> text;
    in property <bool> searching: true;
    VerticalLayout {
        padding: 32px;
        spacing: 14px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            if root.searching: Spinner {
                width: 36px;
                height: 36px;
                indeterminate: true;
            }
            if !root.searching: Icon {
                name: Icons.info;
                color: Theme.text-muted;
                width: 34px;
                height: 34px;
            }
        }
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-heading;
            font-weight: 600;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: root.text;
            color: Theme.text-muted;
            font-size: Theme.font-body;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// Libellé de champ au-dessus de son contrôle.
component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 6px;
    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.font-small;
        font-weight: 600;
    }
    @children
}

// Défilement horizontal d'une rangée (puces).
component ChipRow inherits Flickable {
    height: 46px;
    interactive: true;
    content-height: 46px;
}

// Présentation du casque : illustration, nom, connexion, batterie.
component HeroCard inherits Card {
    in property <string> title;
    in property <string> connection;
    in property <bool> connected;
    in property <int> battery-level: -1;
    in property <string> battery-text;
    in property <string> battery-estimate;
    in property <[Row]> rows;
    in property <string> stream;
    out property <length> content-height: lay.preferred-height;
    // Calculé sur changement (et non lié) : évite une boucle de mise en page.
    private property <bool> wide;
    init => {
        self.wide = self.width >= 540px;
    }
    changed width => {
        self.wide = self.width >= 540px;
    }

    clip: true;
    // Halo bleu derrière l'illustration.
    Rectangle {
        x: root.wide ? -root.width * 0.1 : (root.width - self.width) / 2;
        y: root.wide ? -40px : -60px;
        width: root.wide ? root.width * 0.75 : 380px;
        height: self.width;
        background: @radial-gradient(circle, Theme.accent.with-alpha(Theme.dark ? 0.32 : 0.18) 0%, Theme.accent.with-alpha(0) 68%);
    }

    lay := VerticalLayout {
        padding: Theme.pad;
        padding-left: root.wide ? 28px : Theme.pad;
        spacing: 12px;

        VerticalLayout {
            spacing: 4px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: "Votre casque, à votre façon";
                color: Theme.text-muted;
                font-size: Theme.font-body;
            }
        }

        if root.wide: HorizontalLayout {
            spacing: 16px;
            Image {
                source: @image-url("images/headset.svg");
                image-fit: contain;
                height: 270px;
                horizontal-stretch: 1;
                opacity: root.connected ? 1 : 0.55;
                animate opacity { duration: Theme.smooth; }
            }
            info-wide := VerticalLayout {
                width: 250px;
                spacing: 14px;
                alignment: center;
                HorizontalLayout {
                    alignment: start;
                    StatusPill {
                        text: root.connection;
                        level: root.connected ? 2 : 1;
                    }
                }
                if root.battery-level >= 0: HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 46px;
                            height: 22px;
                            border-radius: 6px;
                            border-width: 2px;
                            border-color: Theme.text-muted;
                            Rectangle {
                                x: 4px;
                                y: 4px;
                                height: parent.height - 8px;
                                width: (parent.width - 8px) * root.battery-level / 100;
                                border-radius: 3px;
                                background: root.battery-level > 20 ? Theme.success : root.battery-level > 10 ? Theme.warning : Theme.danger;
                                animate width { duration: Theme.smooth; }
                            }
                        }
                    }
                    Text {
                        text: root.battery-level + " %";
                        color: Theme.text;
                        font-size: 22px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                if root.battery-estimate != "": Caption {
                    text: root.battery-estimate;
                }
                if root.stream != "": Caption {
                    text: root.stream;
                }
                if root.rows.length > 0: Rectangle {
                    border-radius: Theme.radius;
                    background: Theme.surface-raised.with-alpha(0.7);
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        RowList {
                            rows: root.rows;
                        }
                    }
                }
            }
        }

        if !root.wide: VerticalLayout {
            spacing: 14px;
            Image {
                source: @image-url("images/headset.svg");
                image-fit: contain;
                height: 190px;
                opacity: root.connected ? 1 : 0.55;
            }
            HorizontalLayout {
                spacing: 12px;
                StatusPill {
                    text: root.connection;
                    level: root.connected ? 2 : 1;
                    horizontal-stretch: 1;
                }
                if root.battery-level >= 0: Text {
                    text: "Batterie " + root.battery-level + " %";
                    color: Theme.text;
                    font-size: Theme.font-heading;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            if root.battery-estimate != "": Caption {
                text: root.battery-estimate;
            }
            if root.rows.length > 0: Rectangle {
                border-radius: Theme.radius;
                background: Theme.surface-raised.with-alpha(0.7);
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    RowList {
                        rows: root.rows;
                    }
                }
            }
        }
    }
}

// Panneau rapide : ouvert d'un clic gauche sur l'icône, près de l'horloge.
// Il se ferme avec Échap, « Fermer », ou dès qu'une autre fenêtre passe au
// premier plan.
export component QuickPanel inherits Window {
    title: "MOMENTUM 5 — panneau rapide";
    no-frame: true;
    always-on-top: true;
    width: 380px;
    background: Theme.background;
    // Le clavier va au gestionnaire de touches dès l'ouverture (Échap).
    forward-focus: keys;

    in property <string> device-title;
    in property <string> battery-text;
    in property <bool> connected;
    in property <bool> can-write;
    in property <bool> busy;
    in property <[string]> noise-modes;
    in property <int> noise-mode;
    in-out property <float> level;
    in property <bool> profile-on;
    in property <bool> profile-available;
    in property <[string]> scene-names;
    // Sections montrées (choisies dans la fenêtre, page Scènes).
    in property <bool> show-noise: true;
    in property <bool> show-level: true;
    in property <bool> show-profile: true;
    callback noise-mode-clicked(int);
    callback level-released(float);
    callback profile-toggled(bool);
    callback scene-clicked(string);
    callback open-window();
    callback close-panel();

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-panel();
                return accept;
            }
            reject
        }
        Rectangle {
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: Theme.radius;
            background: Theme.surface;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: Icons.headphones;
                            color: Theme.accent;
                            width: 22px;
                            height: 22px;
                        }
                    }
                    Text {
                        text: root.device-title;
                        color: Theme.text;
                        font-weight: 700;
                        font-size: 15px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    if root.busy: Spinner {
                        width: 16px;
                        height: 16px;
                        indeterminate: true;
                    }
                    Text {
                        text: root.battery-text;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }
                if !root.connected: HorizontalLayout {
                    spacing: 10px;
                    Spinner {
                        width: 18px;
                        height: 18px;
                        indeterminate: true;
                    }
                    Text {
                        text: "Recherche du casque…";
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }
                if root.connected && root.show-noise: HorizontalLayout {
                    spacing: 8px;
                    for mode[i] in root.noise-modes: Chip {
                        text: mode;
                        horizontal-stretch: 1;
                        selected: root.noise-mode == i;
                        enabled: root.can-write;
                        clicked => {
                            root.noise-mode-clicked(i);
                        }
                    }
                }
                if root.connected && root.show-level && root.noise-mode == 1: HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "ANC";
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    ThemedSlider {
                        minimum: 0;
                        maximum: 100;
                        step: 5;
                        value <=> root.level;
                        enabled: root.can-write;
                        accessible-label: "Curseur ANC ↔ transparence";
                        released(v) => {
                            root.level-released(v);
                        }
                    }
                    Text {
                        text: "Transp.";
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }
                if root.connected && root.show-profile && root.profile-available: ToggleRow {
                    icon: Icons.ear;
                    title: "Profil personnalisé";
                    checked: root.profile-on;
                    enabled: root.can-write;
                    busy: root.busy;
                    toggled(on) => {
                        root.profile-toggled(on);
                    }
                }
                if root.connected && root.scene-names.length > 0: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for name in root.scene-names: Chip {
                        icon: Icons.star;
                        text: name;
                        enabled: root.can-write;
                        clicked => {
                            root.scene-clicked(name);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    ActionButton {
                        text: "Ouvrir la fenêtre";
                        kind: "primary";
                        clicked => {
                            root.open-window();
                        }
                    }
                    ActionButton {
                        text: "Fermer";
                        kind: "ghost";
                        clicked => {
                            root.close-panel();
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "OpenHeadset Control — MOMENTUM 5 (non officiel)";
    icon: root.app-icon;
    // Petite fenêtre ou format mobile acceptés : la disposition s'adapte.
    min-width: 360px;
    min-height: 520px;
    preferred-width: 1280px;
    preferred-height: 860px;
    background: Theme.background;
    default-font-size: Theme.font-body;

    in property <image> app-icon;
    // Page affichée : 0 Accueil, 1 Égaliseur (mode audio et égaliseur),
    // 2 Paramètres du casque, 3 Batterie, 4 Connexion et audio, 5 Scènes,
    // 6 Application (à propos), 7 Commandes (tactile et raccourcis).
    in-out property <int> page;
    changed page => {
        if root.page == 4 {
            root.audio-page-shown();
        }
        if root.page == 5 {
            root.scenes-page-shown();
        }
    }

    // Éditeur de scènes et panneau rapide (page Scènes). Les réglages de la
    // scène choisie sont des indices dans les listes de choix (0 = inchangé).
    in property <[string]> scene-list;
    in-out property <int> scene-selected;
    in-out property <string> scene-name;
    in-out property <int> scene-sound;
    in-out property <int> scene-spatial;
    in-out property <int> scene-noise;
    in-out property <string> scene-level;
    in-out property <int> scene-anti-wind;
    in-out property <int> scene-touch;
    in-out property <int> scene-equalizer;
    in-out property <int> scene-bass-boost;
    in-out property <bool> scene-in-panel;
    in property <[string]> scene-switch-choices;
    in property <[string]> scene-sound-choices;
    in property <[string]> scene-noise-choices;
    in property <[string]> scene-eq-choices;
    in property <string> scene-preview;
    in property <string> scene-error;
    in property <string> scene-message;
    in property <bool> scene-dirty;
    in property <bool> scene-can-save;
    in property <bool> scene-can-apply;
    in-out property <bool> confirm-scene-delete;
    in-out property <bool> panel-show-noise;
    in-out property <bool> panel-show-level;
    in-out property <bool> panel-show-profile;
    callback scenes-page-shown();
    callback scene-select(int);
    callback scene-form-changed();
    callback scene-new();
    callback scene-duplicate();
    callback scene-delete();
    callback scene-move(int);
    callback scene-save();
    callback scene-revert();
    callback scene-apply();
    callback scene-panel-toggled(bool);
    callback panel-sections-changed();
    callback open-scenes-file();

    // Connexion et audio (lecture seule).
    in property <[Finding]> audio-findings;
    in property <[InfoRow]> audio-control;
    in property <[InfoRow]> audio-windows;
    in property <[InfoRow]> audio-stream;
    callback audio-page-shown();
    callback open-sound-settings();

    // En-tête et état (modèle de vue Rust).
    in property <string> device-title;
    in property <string> connection;
    in property <bool> connected;
    in property <bool> can-write;
    in property <string> battery-text;
    in property <string> banner;
    in property <bool> banner-is-warning;
    in property <string> waiting;
    in property <[Row]> home-rows;
    in property <[Row]> about-rows;

    // Batterie : historique local.
    in property <string> battery-path;
    in property <string> battery-current;
    in property <string> battery-estimate;
    in property <string> battery-axis-start;
    in property <[Row]> battery-rows;
    in property <[string]> battery-spans;
    in-out property <int> battery-span;
    in-out property <bool> confirm-clear-battery;
    callback battery-span-selected(int);
    callback export-battery();
    callback clear-battery();

    // Diagnostic expurgé (À propos).
    in property <string> diagnostic;
    in-out property <bool> diagnostic-copied;
    callback prepare-diagnostic();
    in property <[ConnectionRow]> connections;
    in property <[string]> scene-names;
    callback scene-clicked(string);
    callback reload-scenes();
    callback connection-clicked(int, string);
    in property <string> stream;

    // Commandes de l'Accueil (état fourni par Rust, clics renvoyés à Rust).
    in property <[string]> noise-modes;
    in property <int> noise-mode: -1;
    in-out property <float> level;
    in-out property <bool> anti-wind;
    in-out property <bool> spatial-on;
    in property <bool> spatial-enabled;
    in-out property <bool> head-tracking-on;
    in property <bool> head-tracking-enabled;
    callback head-tracking-toggled(bool);
    in-out property <bool> multipoint-on;
    in property <bool> multipoint-enabled;
    in-out property <bool> confirm-multipoint-off;
    callback multipoint-changed(bool);
    in-out property <bool> touch-on;
    in property <bool> touch-enabled;

    // Mon son (état fourni par Rust).
    in property <[string]> audio-modes;
    in property <int> audio-mode: -1;
    in property <bool> modes-enabled;
    in property <bool> profile-available;
    in property <[string]> preset-names;
    in-out property <int> preset-index;
    in property <[bool]> preset-removable;
    in property <string> preset-status;
    in-out property <string> new-preset-name;

    callback audio-mode-clicked(int);
    callback export-profile();
    callback apply-preset(int);
    callback delete-preset(int);
    callback save-preset(string);

    // Réglages (état fourni par Rust).
    in-out property <bool> smart-pause-on;
    in property <bool> smart-pause-enabled;
    in-out property <bool> auto-answer-on;
    in property <bool> auto-answer-enabled;
    in-out property <bool> comfort-on;
    in property <bool> comfort-enabled;
    in-out property <bool> battery-protection-on;
    in property <bool> battery-protection-enabled;
    in property <[string]> auto-off-labels;
    in-out property <int> auto-off;
    in property <bool> auto-off-enabled;
    in property <[string]> prompt-modes;
    in property <int> prompt-mode: -1;
    in property <bool> prompts-enabled;
    in property <[Row]> settings-info;
    // Raccourcis clavier (Réglages).
    in property <[HotkeyRow]> hotkey-rows;
    callback hotkey-edited(int, string);
    callback save-hotkeys();

    // Égaliseur : saisie, fichiers, comparaison A/B (Mon son).
    in-out property <string> gains-text;
    in property <string> gains-placeholder;
    in property <bool> ab-ready;
    in property <string> ab-status;
    callback apply-gains-text(string);
    callback export-curve();
    callback import-curve();
    callback remember-a();
    callback toggle-ab();

    in property <string> headset-name;
    in property <bool> rename-enabled;
    in-out property <string> new-name;
    callback rename(string);
    in-out property <float> prompt-volume;
    in property <bool> prompt-volume-enabled;
    callback prompt-volume-released(float);

    callback smart-pause-toggled(bool);
    callback auto-answer-toggled(bool);
    callback comfort-toggled(bool);
    callback battery-protection-toggled(bool);
    callback auto-off-selected(int);
    callback prompt-mode-clicked(int);

    callback noise-mode-clicked(int);
    callback level-released(float);
    callback anti-wind-toggled(bool);
    callback spatial-toggled(bool);
    callback touch-toggled(bool);

    // Égaliseur.
    in property <[Band]> bands;
    in property <float> min-gain: -6;
    in property <float> max-gain: 6;
    in-out property <bool> bass-boost;
    in property <string> eq-status;

    callback band-released(int, float);
    callback bass-boost-toggled(bool);
    callback reset-flat();

    // Ajouts d'OpenHeadset Control.
    // Une commande est partie vers le casque et attend sa confirmation.
    in property <bool> busy;
    // Mode démonstration : données simulées, aucun casque.
    in property <bool> demo;
    // Batterie en pourcentage (-1 : inconnue).
    in property <int> battery-level: -1;
    // Modèle, micrologiciel… lus sur le casque.
    in property <[Row]> device-rows;
    // Raccourcis globaux pris en charge par ce système.
    in property <bool> hotkeys-supported: true;
    // Nom du système (« Windows », « Linux ») dans les libellés.
    in property <string> system-name: "Windows";
    // Thème : sombre par défaut ; `theme-changed` pour l'enregistrer.
    in-out property <bool> dark-theme: true;
    callback theme-changed(bool);

    init => {
        root.update-layout();
        Theme.dark = root.dark-theme;
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-theme => {
        Theme.dark = root.dark-theme;
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }

    // Disposition selon la largeur.
    // Seuils calculés sur changement de largeur (et non liés) : une liaison
    // directe ferait dépendre la largeur minimale de la largeur elle-même.
    private property <bool> narrow;
    private property <bool> rail;
    function update-layout() {
        root.narrow = root.width < 720px;
        root.rail = !root.narrow && root.width < 1100px;
    }
    changed width => {
        root.update-layout();
    }
    private property <length> nav-width: root.narrow ? 0px : root.rail ? 84px : 240px;
    private property <length> content-pad: root.narrow ? 14px : 26px;
    // Section de la navigation (5 entrées) d'après la page.
    private property <int> section: root.page == 0 ? 0 : (root.page == 3 || root.page == 4) ? 1 : root.page == 1 ? 2 : (root.page == 5 || root.page == 7) ? 3 : 4;
    private property <[string]> section-names: ["Accueil", "Appareil", "Égaliseur", "Commandes", "Paramètres"];
    private property <[string]> section-icons: [Icons.home, Icons.headphones, Icons.equalizer, Icons.touch, Icons.gear];
    // Première page de chaque section.
    private property <[int]> section-pages: [0, 4, 1, 7, 2];

    // Icônes et descriptions des modes de bruit, dans l'ordre des boutons.
    private property <[string]> noise-icons: [Icons.waves, Icons.sliders, Icons.person];
    private property <[string]> noise-hints: ["S'adapte à l'environnement", "ANC ou transparence, au curseur", "Son naturel, sans traitement"];

    function go(section: int) {
        root.page = root.section-pages[section];
    }
    function toggle-theme() {
        root.dark-theme = !root.dark-theme;
        root.theme-changed(root.dark-theme);
    }

    // Halo de fond.
    Rectangle {
        x: root.width - self.width * 0.6;
        y: -self.height * 0.45;
        width: 900px;
        height: 900px;
        background: @radial-gradient(circle, Theme.background-glow.with-alpha(Theme.dark ? 0.55 : 0.8) 0%, Theme.background.with-alpha(0) 70%);
    }

    HorizontalLayout {
        // Navigation latérale (ou rail).
        if !root.narrow: Rectangle {
            width: root.nav-width;
            background: Theme.sidebar.with-alpha(0.92);
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border;
            }
            VerticalLayout {
                padding: root.rail ? 12px : 18px;
                padding-top: 20px;
                spacing: 6px;
                HorizontalLayout {
                    height: 52px;
                    spacing: 12px;
                    padding-left: root.rail ? 0px : 8px;
                    alignment: root.rail ? center : start;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: Icons.headphones;
                            color: Theme.accent;
                            width: 30px;
                            height: 30px;
                            stroke-width: 2.2px;
                        }
                    }
                    if !root.rail: VerticalLayout {
                        alignment: center;
                        Text {
                            text: "OpenHeadset";
                            color: Theme.text;
                            font-size: 17px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Control";
                            color: Theme.text-muted;
                            font-size: 13px;
                        }
                    }
                }
                Rectangle {
                    height: 14px;
                }
                for name[i] in root.section-names: NavItem {
                    icon: root.section-icons[i];
                    label: name;
                    compact: root.rail;
                    selected: root.section == i;
                    clicked => {
                        root.go(i);
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                NavItem {
                    icon: Theme.dark ? Icons.sun : Icons.moon;
                    label: Theme.dark ? "Thème clair" : "Thème sombre";
                    compact: root.rail;
                    clicked => {
                        root.toggle-theme();
                    }
                }
                if !root.rail: HorizontalLayout {
                    padding-left: 8px;
                    padding-top: 8px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: Icons.code;
                            color: Theme.text-faint;
                        }
                    }
                    VerticalLayout {
                        Text {
                            text: "Open source";
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                        }
                        Text {
                            text: "Non officiel, sans lien avec Sennheiser";
                            color: Theme.text-faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;

            // Barre supérieure : section, envoi en cours, connexion.
            Rectangle {
                height: root.narrow ? 62px : 72px;
                HorizontalLayout {
                    padding-left: root.content-pad;
                    padding-right: root.content-pad;
                    spacing: 12px;
                    if root.narrow: VerticalLayout {
                        alignment: center;
                        Icon {
                            name: Icons.headphones;
                            color: Theme.accent;
                            width: 26px;
                            height: 26px;
                        }
                    }
                    Text {
                        text: root.section-names[root.section];
                        color: Theme.text;
                        font-size: root.narrow ? 20px : 24px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.demo: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            width: demo-text.preferred-width + 20px;
                            border-radius: 14px;
                            background: Theme.warning-soft;
                            border-width: 1px;
                            border-color: Theme.warning;
                            demo-text := Text {
                                text: root.narrow ? "Démo" : "Démonstration : données simulées";
                                color: Theme.warning;
                                font-size: Theme.font-small;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if root.busy: HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Spinner {
                                width: 18px;
                                height: 18px;
                                indeterminate: true;
                            }
                        }
                        if !root.narrow: Text {
                            text: "Envoi au casque…";
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                    }
                    if !root.narrow: VerticalLayout {
                        alignment: center;
                        StatusPill {
                            text: root.connected ? "Casque connecté" : root.connection;
                            level: root.connected ? 2 : 1;
                            max-width: 320px;
                        }
                    }
                    if root.narrow: VerticalLayout {
                        alignment: center;
                        ActionButton {
                            icon: Theme.dark ? Icons.sun : Icons.moon;
                            kind: "ghost";
                            width: 40px;
                            accessible-label: "Changer de thème";
                            clicked => {
                                root.toggle-theme();
                            }
                        }
                    }
                }
            }

            // Bandeau : incident, lecture seule, information.
            if root.banner != "": HorizontalLayout {
                padding-left: root.content-pad;
                padding-right: root.content-pad;
                padding-bottom: 6px;
                AlertBanner {
                    text: root.banner;
                    warning: root.banner-is-warning;
                }
            }

            // ───────────── Accueil : casque absent ─────────────
            if root.section == 0 && !root.connected: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: root.content-pad;
                    spacing: Theme.gap;
                    alignment: start;
                    HeroCard {
                        height: self.content-height;
                        title: root.device-title;
                        connection: root.connection;
                        connected: false;
                        battery-level: -1;
                        rows: root.device-rows;
                    }
                    EmptyState {
                        title: "En attente du casque";
                        text: root.waiting;
                    }
                }
            }

            // ───────────── Accueil : tableau de bord ─────────────
            if root.section == 0 && root.connected: dash-scroll := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: dash.height + 2 * root.content-pad;
                dash := Rectangle {
                    x: root.content-pad;
                    y: root.content-pad;
                    width: dash-scroll.visible-width - 2 * root.content-pad;
                    // Deux colonnes dès que la place le permet.
                    property <bool> two: self.width >= 900px;
                    property <length> gap: Theme.gap;
                    property <length> w1: self.two ? (self.width - self.gap) * 0.52 : self.width;
                    property <length> w2: self.two ? self.width - self.w1 - self.gap : self.width;
                    property <length> x2: self.two ? self.w1 + self.gap : 0px;
                    height: self.two ? max(eq-card.y + eq-card.height, scenes-card.y + scenes-card.height) : scenes-card.y + scenes-card.height;

                    hero := HeroCard {
                        x: 0px;
                        y: 0px;
                        width: dash.w1;
                        height: self.content-height;
                        title: root.device-title;
                        connection: root.connection;
                        connected: true;
                        battery-level: root.battery-level;
                        battery-text: root.battery-text;
                        battery-estimate: root.battery-estimate;
                        rows: root.device-rows;
                        stream: root.stream;
                    }

                    // Réduction de bruit.
                    noise-card := Card {
                        x: dash.x2;
                        y: dash.two ? 0px : hero.y + hero.height + dash.gap;
                        width: dash.w2;
                        height: noise-lay.preferred-height;
                        noise-lay := VerticalLayout {
                            padding: Theme.pad;
                            spacing: 16px;
                            CardHeader {
                                icon: Icons.waves;
                                title: "Réduction de bruit active (ANC)";
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                for mode[i] in root.noise-modes: ModeTile {
                                    icon: root.noise-icons[i];
                                    title: mode;
                                    subtitle: noise-card.width >= 470px ? root.noise-hints[i] : "";
                                    selected: root.noise-mode == i;
                                    enabled: root.can-write;
                                    busy: root.busy;
                                    compact: root.narrow;
                                    clicked => {
                                        root.noise-mode-clicked(i);
                                    }
                                }
                            }
                            // Toujours visible, comme dans l'app : le casque passe en
                            // « Personnalisé » dès qu'on règle le curseur.
                            VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    Text {
                                        text: root.noise-mode == 1 ? "ANC ↔ transparence" : "ANC ↔ transparence (passe en Personnalisé)";
                                        color: Theme.text;
                                        font-weight: 600;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: round(root.level) + " %";
                                        color: Theme.accent-strong;
                                        font-weight: 600;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Caption {
                                        text: "ANC";
                                        vertical-alignment: center;
                                        wrap: no-wrap;
                                    }
                                    ThemedSlider {
                                        minimum: 0;
                                        maximum: 100;
                                        step: 5;
                                        value <=> root.level;
                                        enabled: root.can-write;
                                        accessible-label: "Curseur ANC ↔ transparence";
                                        released(v) => {
                                            root.level-released(v);
                                        }
                                    }
                                    Caption {
                                        text: "Transparence";
                                        vertical-alignment: center;
                                        wrap: no-wrap;
                                    }
                                }
                            }
                            ToggleRow {
                                icon: Icons.wind;
                                title: "Anti-vent";
                                subtitle: "Atténue le bruit du vent dans les micros";
                                checked: root.anti-wind;
                                enabled: root.can-write;
                                busy: root.busy;
                                toggled(on) => {
                                    root.anti-wind-toggled(on);
                                }
                            }
                        }
                    }

                    // Égaliseur (aperçu).
                    eq-card := Card {
                        x: 0px;
                        y: dash.two ? hero.y + hero.height + dash.gap : noise-card.y + noise-card.height + dash.gap;
                        width: dash.w1;
                        height: eq-lay.preferred-height;
                        eq-lay := VerticalLayout {
                            padding: Theme.pad;
                            spacing: 14px;
                            CardHeader {
                                icon: Icons.equalizer;
                                title: "Égaliseur";
                                ActionButton {
                                    icon: Icons.reset;
                                    text: eq-card.width >= 420px ? "Réinitialiser" : "";
                                    kind: "ghost";
                                    enabled: root.can-write;
                                    accessible-label: "Remettre l'égaliseur à plat";
                                    clicked => {
                                        root.reset-flat();
                                    }
                                }
                            }
                            EqualizerPanel {
                                height: 250px;
                                bands: root.bands;
                                min-gain: root.min-gain;
                                max-gain: root.max-gain;
                                enabled: root.can-write;
                                busy: root.busy;
                                show-bass: false;
                                band-released(i, db) => {
                                    root.band-released(i, db);
                                }
                            }
                            ChipRow {
                                content-width: eq-chips.preferred-width;
                                eq-chips := HorizontalLayout {
                                    spacing: 8px;
                                    for name[i] in root.preset-names: Chip {
                                        icon: i == 0 ? Icons.sliders : Icons.sparkle;
                                        text: name;
                                        selected: root.preset-index == i;
                                        enabled: root.can-write;
                                        clicked => {
                                            root.preset-index = i;
                                            root.apply-preset(i);
                                        }
                                    }
                                    Chip {
                                        text: "Tous les réglages…";
                                        clicked => {
                                            root.page = 1;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Fonctions rapides.
                    quick-card := Card {
                        x: dash.x2;
                        y: dash.two ? noise-card.y + noise-card.height + dash.gap : eq-card.y + eq-card.height + dash.gap;
                        width: dash.w2;
                        height: quick-lay.preferred-height;
                        quick-lay := VerticalLayout {
                            padding: Theme.pad;
                            spacing: 14px;
                            CardHeader {
                                icon: Icons.sliders;
                                title: "Fonctionnalités rapides";
                            }
                            grid := Rectangle {
                                property <int> cols: self.width >= 460px ? 2 : 1;
                                property <length> cell-w: (self.width - (self.cols - 1) * 12px) / self.cols;
                                property <length> cell-h: 76px;
                                property <length> step-y: self.cell-h + 12px;
                                height: ceil(6 / self.cols) * self.step-y - 12px;
                                ToggleRow {
                                    x: 0px;
                                    y: 0px;
                                    width: grid.cell-w;
                                    height: grid.cell-h;
                                    icon: Icons.devices;
                                    title: "Multipoint";
                                    subtitle: "2 appareils à la fois";
                                    checked: root.multipoint-on;
                                    enabled: root.multipoint-enabled && !root.confirm-multipoint-off;
                                    busy: root.busy || root.confirm-multipoint-off;
                                    toggled(on) => {
                                        if on {
                                            root.multipoint-changed(true);
                                        } else {
                                            // Coupure : confirmation d'abord.
                                            root.confirm-multipoint-off = true;
                                        }
                                    }
                                }
                                ToggleRow {
                                    x: mod(1, grid.cols) * (grid.cell-w + 12px);
                                    y: floor(1 / grid.cols) * grid.step-y;
                                    width: grid.cell-w;
                                    height: grid.cell-h;
                                    icon: Icons.pause;
                                    title: "Smart Pause";
                                    subtitle: "Au retrait du casque";
                                    checked: root.smart-pause-on;
                                    enabled: root.smart-pause-enabled;
                                    busy: root.busy;
                                    toggled(on) => {
                                        root.smart-pause-toggled(on);
                                    }
                                }
                                ToggleRow {
                                    x: mod(2, grid.cols) * (grid.cell-w + 12px);
                                    y: floor(2 / grid.cols) * grid.step-y;
                                    width: grid.cell-w;
                                    height: grid.cell-h;
                                    icon: Icons.chat;
                                    title: "Messages vocaux";
                                    subtitle: "Voix et tonalités";
                                    checked: root.prompt-mode == 1;
                                    enabled: root.prompts-enabled;
                                    busy: root.busy;
                                    toggled(on) => {
                                        root.prompt-mode-clicked(on ? 1 : 0);
                                    }
                                }
                                ToggleRow {
                                    x: mod(3, grid.cols) * (grid.cell-w + 12px);
                                    y: floor(3 / grid.cols) * grid.step-y;
                                    width: grid.cell-w;
                                    height: grid.cell-h;
                                    icon: Icons.orbit;
                                    title: "Audio spatial";
                                    subtitle: "Dolby Atmos";
                                    checked: root.spatial-on;
                                    enabled: root.spatial-enabled;
                                    busy: root.busy;
                                    toggled(on) => {
                                        root.spatial-toggled(on);
                                    }
                                }
                                ToggleRow {
                                    x: mod(4, grid.cols) * (grid.cell-w + 12px);
                                    y: floor(4 / grid.cols) * grid.step-y;
                                    width: grid.cell-w;
                                    height: grid.cell-h;
                                    icon: Icons.touch;
                                    title: "Commandes tactiles";
                                    subtitle: "Gestes";
                                    checked: root.touch-on;
                                    enabled: root.touch-enabled;
                                    busy: root.busy;
                                    toggled(on) => {
                                        root.touch-toggled(on);
                                    }
                                }
                                ToggleRow {
                                    x: mod(5, grid.cols) * (grid.cell-w + 12px);
                                    y: floor(5 / grid.cols) * grid.step-y;
                                    width: grid.cell-w;
                                    height: grid.cell-h;
                                    icon: Icons.headphones;
                                    title: "Suivi de tête";
                                    subtitle: "Avec l'audio spatial";
                                    checked: root.head-tracking-on;
                                    enabled: root.head-tracking-enabled;
                                    busy: root.busy;
                                    toggled(on) => {
                                        root.head-tracking-toggled(on);
                                    }
                                }
                            }
                            if root.confirm-multipoint-off: AlertBanner {
                                warning: true;
                                text: "Sans Multipoint, le casque ne garde qu'un appareil : l'autre est déconnecté (lors de l'essai depuis ce PC, c'était le téléphone).";
                            }
                            if root.confirm-multipoint-off: HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                ActionButton {
                                    text: "Annuler";
                                    kind: "ghost";
                                    clicked => {
                                        root.confirm-multipoint-off = false;
                                    }
                                }
                                ActionButton {
                                    text: "Couper le Multipoint";
                                    kind: "danger";
                                    clicked => {
                                        root.confirm-multipoint-off = false;
                                        root.multipoint-changed(false);
                                    }
                                }
                            }
                        }
                    }

                    // Bluetooth : flux et appareils.
                    bt-card := Card {
                        x: dash.x2;
                        y: quick-card.y + quick-card.height + dash.gap;
                        width: dash.w2;
                        height: bt-lay.preferred-height;
                        bt-lay := VerticalLayout {
                            padding: Theme.pad;
                            spacing: 8px;
                            CardHeader {
                                icon: Icons.bluetooth;
                                title: "Informations Bluetooth";
                                ActionButton {
                                    icon: Icons.chevron-right;
                                    text: "Détails";
                                    kind: "ghost";
                                    clicked => {
                                        root.page = 4;
                                    }
                                }
                            }
                            if root.audio-stream.length == 0: KeyValue {
                                label: "Flux audio";
                                value: "pas encore annoncé par le casque";
                                last: root.connections.length == 0;
                            }
                            InfoList {
                                rows: root.audio-stream;
                            }
                            for c[i] in root.connections: HorizontalLayout {
                                spacing: 12px;
                                padding-top: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        name: Icons.phone;
                                        color: Theme.text-muted;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: c.name;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Caption {
                                        text: c.status;
                                    }
                                }
                                ActionButton {
                                    text: c.action;
                                    enabled: c.can-act;
                                    clicked => {
                                        root.connection-clicked(i, c.name);
                                    }
                                }
                            }
                        }
                    }

                    // Scènes.
                    scenes-card := Card {
                        x: dash.x2;
                        y: bt-card.y + bt-card.height + dash.gap;
                        width: dash.w2;
                        height: scenes-lay.preferred-height;
                        scenes-lay := VerticalLayout {
                            padding: Theme.pad;
                            spacing: 12px;
                            CardHeader {
                                icon: Icons.star;
                                title: "Scènes";
                                ActionButton {
                                    icon: Icons.pencil;
                                    text: "Modifier";
                                    kind: "ghost";
                                    clicked => {
                                        root.page = 5;
                                    }
                                }
                            }
                            if root.scene-names.length == 0: Caption {
                                text: "Aucune scène. Créez-en dans Commandes › Scènes.";
                            }
                            ChipRow {
                                content-width: scene-chips.preferred-width;
                                scene-chips := HorizontalLayout {
                                    spacing: 8px;
                                    for name in root.scene-names: Chip {
                                        icon: Icons.star;
                                        text: name;
                                        enabled: root.can-write;
                                        clicked => {
                                            root.scene-clicked(name);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ───────────── Appareil : connexion et audio, batterie ─────────────
            if root.section == 1: ScrollView {
                vertical-stretch: 1;
                HorizontalLayout {
                    padding: root.content-pad;
                    alignment: center;
                    VerticalLayout {
                        max-width: 1040px;
                        horizontal-stretch: 1;
                        spacing: Theme.gap;
                        alignment: start;
                        Segmented {
                            items: ["Connexion et audio", "Batterie"];
                            current: root.page == 4 ? 0 : 1;
                            selected(i) => {
                                root.page = i == 0 ? 4 : 3;
                            }
                        }

                        if root.page == 4: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 12px;
                                CardHeader {
                                    icon: Icons.info;
                                    title: "Ce qu'il faut vérifier";
                                }
                                for f in root.audio-findings: HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: start;
                                        Icon {
                                            name: f.problem ? Icons.warning : Icons.check;
                                            color: f.problem ? Theme.danger : Theme.success;
                                        }
                                    }
                                    Text {
                                        text: f.text;
                                        color: Theme.text;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    ActionButton {
                                        icon: Icons.reset;
                                        text: "Relire";
                                        clicked => {
                                            root.audio-page-shown();
                                        }
                                    }
                                    ActionButton {
                                        icon: Icons.gear;
                                        text: "Paramètres de son de " + root.system-name;
                                        kind: "ghost";
                                        clicked => {
                                            root.open-sound-settings();
                                        }
                                    }
                                }
                                Caption {
                                    text: "Lecture seule : rien n'est changé dans le système ni sur le casque.";
                                }
                            }
                        }
                        if root.page == 4 && root.connections.length > 0: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 12px;
                                CardHeader {
                                    icon: Icons.devices;
                                    title: "Appareils appairés au casque";
                                }
                                ToggleRow {
                                    icon: Icons.devices;
                                    title: "Multipoint";
                                    subtitle: "Deux appareils connectés à la fois";
                                    checked: root.multipoint-on;
                                    enabled: root.multipoint-enabled && !root.confirm-multipoint-off;
                                    busy: root.busy || root.confirm-multipoint-off;
                                    toggled(on) => {
                                        if on {
                                            root.multipoint-changed(true);
                                        } else {
                                            root.confirm-multipoint-off = true;
                                        }
                                    }
                                }
                                if root.confirm-multipoint-off: AlertBanner {
                                    warning: true;
                                    text: "Sans Multipoint, le casque ne garde qu'un appareil : l'autre est déconnecté (lors de l'essai depuis ce PC, c'était le téléphone).";
                                }
                                if root.confirm-multipoint-off: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;
                                    ActionButton {
                                        text: "Annuler";
                                        kind: "ghost";
                                        clicked => {
                                            root.confirm-multipoint-off = false;
                                        }
                                    }
                                    ActionButton {
                                        text: "Couper le Multipoint";
                                        kind: "danger";
                                        clicked => {
                                            root.confirm-multipoint-off = false;
                                            root.multipoint-changed(false);
                                        }
                                    }
                                }
                                for c[i] in root.connections: HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            name: Icons.phone;
                                            color: Theme.text-muted;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text {
                                            text: c.name;
                                            color: Theme.text;
                                            overflow: elide;
                                        }
                                        Caption {
                                            text: c.status;
                                        }
                                    }
                                    ActionButton {
                                        text: c.action;
                                        enabled: c.can-act;
                                        clicked => {
                                            root.connection-clicked(i, c.name);
                                        }
                                    }
                                }
                            }
                        }
                        if root.page == 4: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 6px;
                                CardHeader {
                                    icon: Icons.bluetooth;
                                    title: "Pilotage du casque";
                                }
                                InfoList {
                                    rows: root.audio-control;
                                }
                            }
                        }
                        if root.page == 4: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 6px;
                                CardHeader {
                                    icon: Icons.sliders;
                                    title: "Sortie audio du système";
                                }
                                InfoList {
                                    rows: root.audio-windows;
                                }
                            }
                        }
                        if root.page == 4 && root.audio-stream.length > 0: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 6px;
                                CardHeader {
                                    icon: Icons.waves;
                                    title: "Flux rapporté par le casque";
                                }
                                InfoList {
                                    rows: root.audio-stream;
                                }
                                Caption {
                                    text: "En Multipoint, l'appareil qui envoie ce flux n'est pas connu.";
                                }
                            }
                        }

                        if root.page == 3: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 14px;
                                CardHeader {
                                    icon: Icons.battery;
                                    title: "Batterie";
                                }
                                HorizontalLayout {
                                    spacing: 14px;
                                    Text {
                                        text: root.battery-current;
                                        color: Theme.text;
                                        font-size: 30px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.battery-estimate;
                                        color: Theme.text-muted;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                                Segmented {
                                    items: root.battery-spans;
                                    current: root.battery-span;
                                    selected(i) => {
                                        root.battery-span-selected(i);
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        Caption {
                                            text: "100 %";
                                        }
                                        Rectangle {
                                            vertical-stretch: 1;
                                        }
                                        Caption {
                                            text: "0 %";
                                        }
                                    }
                                    Rectangle {
                                        height: 200px;
                                        horizontal-stretch: 1;
                                        border-radius: Theme.radius-small;
                                        background: Theme.surface-raised;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        // Repère des 50 %.
                                        Rectangle {
                                            y: parent.height / 2;
                                            height: 1px;
                                            background: Theme.border;
                                        }
                                        if root.battery-path != "": Path {
                                            width: parent.width;
                                            height: parent.height;
                                            commands: root.battery-path;
                                            viewbox-width: 1000;
                                            viewbox-height: 100;
                                            stroke: Theme.accent;
                                            stroke-width: 2.5px;
                                        }
                                        if root.battery-path == "": Text {
                                            text: "Aucune mesure sur cette période";
                                            color: Theme.text-muted;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 44px;
                                    Caption {
                                        text: root.battery-axis-start;
                                    }
                                    Caption {
                                        text: "maintenant";
                                        horizontal-alignment: right;
                                        horizontal-stretch: 1;
                                    }
                                }
                                Caption {
                                    text: "Les périodes sans mesure (casque éteint ou absent, PC en veille) restent vides : rien n'est deviné.";
                                }
                                RowList {
                                    rows: root.battery-rows;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    ActionButton {
                                        icon: Icons.download;
                                        text: "Exporter (CSV)";
                                        clicked => {
                                            root.export-battery();
                                        }
                                    }
                                    if !root.confirm-clear-battery: ActionButton {
                                        text: "Effacer l'historique…";
                                        kind: "ghost";
                                        clicked => {
                                            root.confirm-clear-battery = true;
                                        }
                                    }
                                    if root.confirm-clear-battery: ActionButton {
                                        text: "Confirmer l'effacement";
                                        kind: "danger";
                                        clicked => {
                                            root.confirm-clear-battery = false;
                                            root.clear-battery();
                                        }
                                    }
                                    if root.confirm-clear-battery: ActionButton {
                                        text: "Annuler";
                                        kind: "ghost";
                                        clicked => {
                                            root.confirm-clear-battery = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ───────────── Égaliseur : mode audio, courbe, préréglages ─────────────
            if root.section == 2: ScrollView {
                vertical-stretch: 1;
                HorizontalLayout {
                    padding: root.content-pad;
                    alignment: center;
                    VerticalLayout {
                        max-width: 1040px;
                        horizontal-stretch: 1;
                        spacing: Theme.gap;
                        alignment: start;

                        if !root.connected: EmptyState {
                            title: "Égaliseur indisponible";
                            text: root.waiting;
                        }

                        if root.connected: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 14px;
                                CardHeader {
                                    icon: Icons.ear;
                                    title: "Mode audio";
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    for mode[i] in root.audio-modes: ModeTile {
                                        min-height: root.narrow ? 124px : 104px;
                                        icon: i == 0 ? Icons.equalizer : i == 1 ? Icons.mic : Icons.ear;
                                        title: mode;
                                        selected: root.audio-mode == i;
                                        compact: root.narrow;
                                        enabled: root.modes-enabled && (i != 2 || root.profile-available);
                                        busy: root.busy;
                                        clicked => {
                                            root.audio-mode-clicked(i);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Caption {
                                        text: "Sauvegarde brute du profil personnalisé dans Documents (lecture seule).";
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    ActionButton {
                                        icon: Icons.download;
                                        text: "Exporter le profil";
                                        enabled: root.profile-available;
                                        clicked => {
                                            root.export-profile();
                                        }
                                    }
                                }
                            }
                        }

                        if root.connected: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 14px;
                                CardHeader {
                                    icon: Icons.equalizer;
                                    title: "Égaliseur graphique";
                                    ActionButton {
                                        icon: Icons.reset;
                                        text: "Réinitialiser";
                                        kind: "ghost";
                                        enabled: root.can-write;
                                        clicked => {
                                            root.reset-flat();
                                        }
                                    }
                                }
                                EqualizerPanel {
                                    height: root.narrow ? 300px : 340px;
                                    bands: root.bands;
                                    min-gain: root.min-gain;
                                    max-gain: root.max-gain;
                                    bass-boost: root.bass-boost;
                                    enabled: root.can-write;
                                    busy: root.busy;
                                    status: root.eq-status;
                                    band-released(i, db) => {
                                        root.band-released(i, db);
                                    }
                                    bass-boost-toggled(on) => {
                                        root.bass-boost-toggled(on);
                                    }
                                }
                            }
                        }

                        if root.connected: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 14px;
                                CardHeader {
                                    icon: Icons.sparkle;
                                    title: "Préréglages";
                                    if root.preset-index >= 0 && root.preset-removable[root.preset-index]: ActionButton {
                                        text: "Supprimer";
                                        kind: "danger";
                                        clicked => {
                                            root.delete-preset(root.preset-index);
                                        }
                                    }
                                }
                                ChipRow {
                                    content-width: preset-chips.preferred-width;
                                    preset-chips := HorizontalLayout {
                                        spacing: 8px;
                                        for name[i] in root.preset-names: Chip {
                                            text: name;
                                            selected: root.preset-index == i;
                                            enabled: root.can-write;
                                            clicked => {
                                                root.preset-index = i;
                                                root.apply-preset(i);
                                            }
                                        }
                                    }
                                }
                                if root.preset-status != "": Caption {
                                    text: root.preset-status;
                                }
                                Field {
                                    label: "Enregistrer la courbe actuelle";
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LineEdit {
                                            placeholder-text: "Nom du nouveau préréglage";
                                            text <=> root.new-preset-name;
                                            horizontal-stretch: 1;
                                        }
                                        ActionButton {
                                            icon: Icons.plus;
                                            text: "Enregistrer";
                                            kind: "primary";
                                            enabled: root.new-preset-name != "";
                                            clicked => {
                                                root.save-preset(root.new-preset-name);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.connected: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 14px;
                                CardHeader {
                                    icon: Icons.keyboard;
                                    title: "Saisie, fichiers et comparaison";
                                }
                                Field {
                                    label: "Gains en dB, des graves aux aigus, séparés par « ; »";
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LineEdit {
                                            placeholder-text: root.gains-placeholder;
                                            text <=> root.gains-text;
                                            enabled: root.can-write;
                                            horizontal-stretch: 1;
                                            accessible-label: "Gains en dB, séparés par des points-virgules";
                                            accepted(t) => {
                                                root.apply-gains-text(t);
                                            }
                                        }
                                        ActionButton {
                                            text: "Appliquer";
                                            enabled: root.can-write && root.gains-text != "";
                                            clicked => {
                                                root.apply-gains-text(root.gains-text);
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    ActionButton {
                                        icon: Icons.download;
                                        text: root.narrow ? "Exporter" : "Exporter la courbe";
                                        clicked => {
                                            root.export-curve();
                                        }
                                    }
                                    ActionButton {
                                        icon: Icons.upload;
                                        text: root.narrow ? "Importer" : "Importer une courbe…";
                                        enabled: root.can-write;
                                        clicked => {
                                            root.import-curve();
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    ActionButton {
                                        text: "Mémoriser A";
                                        enabled: root.can-write;
                                        clicked => {
                                            root.remember-a();
                                        }
                                    }
                                    ActionButton {
                                        text: "Comparer A ↔ B";
                                        kind: "primary";
                                        enabled: root.can-write && root.ab-ready;
                                        clicked => {
                                            root.toggle-ab();
                                        }
                                    }
                                }
                                Caption {
                                    text: root.ab-status + " La comparaison porte sur les gains, pas sur les basses.";
                                }
                            }
                        }
                    }
                }
            }

            // ───────────── Commandes : tactile, raccourcis, scènes ─────────────
            if root.section == 3: ScrollView {
                vertical-stretch: 1;
                HorizontalLayout {
                    padding: root.content-pad;
                    alignment: center;
                    VerticalLayout {
                        max-width: 1040px;
                        horizontal-stretch: 1;
                        spacing: Theme.gap;
                        alignment: start;
                        Segmented {
                            items: ["Tactile et raccourcis", "Scènes"];
                            current: root.page == 7 ? 0 : 1;
                            selected(i) => {
                                root.page = i == 0 ? 7 : 5;
                            }
                        }

                        if root.page == 7: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 12px;
                                CardHeader {
                                    icon: Icons.touch;
                                    title: "Commandes du casque";
                                }
                                ToggleRow {
                                    icon: Icons.touch;
                                    title: "Commandes tactiles";
                                    subtitle: "Gestes sur la surface de l'oreillette";
                                    available: root.connected;
                                    checked: root.touch-on;
                                    enabled: root.touch-enabled;
                                    busy: root.busy;
                                    toggled(on) => {
                                        root.touch-toggled(on);
                                    }
                                }
                                Caption {
                                    text: "La correspondance gestes ↔ actions est fixée par le casque ; elle n'est pas modifiable ici.";
                                }
                            }
                        }
                        if root.page == 7: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 12px;
                                CardHeader {
                                    icon: Icons.keyboard;
                                    title: "Raccourcis clavier";
                                }
                                if !root.hotkeys-supported: AlertBanner {
                                    text: "Les raccourcis globaux ne sont pas encore pris en charge sur ce système : ils sont enregistrés mais inactifs.";
                                }
                                for r[i] in root.hotkey-rows: HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: r.label;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        wrap: word-wrap;
                                    }
                                    LineEdit {
                                        text: r.spec;
                                        placeholder-text: "désactivé";
                                        width: root.narrow ? 150px : 220px;
                                        accessible-label: "Touches pour " + r.label;
                                        edited(t) => {
                                            root.hotkey-edited(i, t);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    ActionButton {
                                        icon: Icons.check;
                                        text: "Enregistrer les raccourcis";
                                        kind: "primary";
                                        clicked => {
                                            root.save-hotkeys();
                                        }
                                    }
                                }
                                Caption {
                                    text: "Exemple : Ctrl+Alt+N. Ctrl, Alt ou Win obligatoire, puis une lettre, un chiffre ou F1 à F24. Vide : désactivé. Une ligne par scène du fichier scenes.txt.";
                                }
                            }
                        }

                        if root.page == 5: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 12px;
                                CardHeader {
                                    icon: Icons.star;
                                    title: "Scènes";
                                    ActionButton {
                                        icon: Icons.plus;
                                        text: root.narrow ? "" : "Nouvelle";
                                        accessible-label: "Nouvelle scène";
                                        clicked => {
                                            root.scene-new();
                                        }
                                    }
                                }
                                Caption {
                                    text: "Enregistrer n'envoie rien au casque : « Appliquer au casque » est une action séparée. scenes.txt reste modifiable à la main (copie scenes.txt.bak à chaque enregistrement).";
                                }
                                if root.scene-message != "": AlertBanner {
                                    text: root.scene-message;
                                }
                                ChipRow {
                                    content-width: scene-list-chips.preferred-width;
                                    scene-list-chips := HorizontalLayout {
                                        spacing: 8px;
                                        for name[i] in root.scene-list: Chip {
                                            icon: Icons.star;
                                            text: name;
                                            selected: root.scene-selected == i;
                                            clicked => {
                                                root.confirm-scene-delete = false;
                                                root.scene-select(i);
                                            }
                                        }
                                    }
                                }
                                if root.scene-list.length > 0: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    ActionButton {
                                        text: "Dupliquer";
                                        kind: "ghost";
                                        clicked => {
                                            root.scene-duplicate();
                                        }
                                    }
                                    ActionButton {
                                        icon: Icons.chevron-left;
                                        kind: "ghost";
                                        accessible-label: "Déplacer avant";
                                        enabled: root.scene-selected > 0;
                                        clicked => {
                                            root.scene-move(-1);
                                        }
                                    }
                                    ActionButton {
                                        icon: Icons.chevron-right;
                                        kind: "ghost";
                                        accessible-label: "Déplacer après";
                                        enabled: root.scene-selected >= 0 && root.scene-selected < root.scene-list.length - 1;
                                        clicked => {
                                            root.scene-move(1);
                                        }
                                    }
                                    if !root.confirm-scene-delete: ActionButton {
                                        text: "Supprimer…";
                                        kind: "ghost";
                                        clicked => {
                                            root.confirm-scene-delete = true;
                                        }
                                    }
                                    if root.confirm-scene-delete: ActionButton {
                                        text: "Confirmer";
                                        kind: "danger";
                                        clicked => {
                                            root.confirm-scene-delete = false;
                                            root.scene-delete();
                                        }
                                    }
                                    if root.confirm-scene-delete: ActionButton {
                                        text: "Annuler";
                                        kind: "ghost";
                                        clicked => {
                                            root.confirm-scene-delete = false;
                                        }
                                    }
                                }
                            }
                        }
                        if root.page == 5 && root.scene-list.length > 0: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 12px;
                                CardHeader {
                                    icon: Icons.pencil;
                                    title: "Scène choisie";
                                }
                                Field {
                                    label: "Nom";
                                    LineEdit {
                                        text <=> root.scene-name;
                                        edited => {
                                            root.scene-form-changed();
                                        }
                                    }
                                }
                                Field {
                                    label: "Mode audio";
                                    ComboBox {
                                        model: root.scene-sound-choices;
                                        current-index <=> root.scene-sound;
                                        selected => {
                                            root.scene-form-changed();
                                        }
                                    }
                                }
                                Field {
                                    label: "Audio spatial";
                                    ComboBox {
                                        model: root.scene-switch-choices;
                                        current-index <=> root.scene-spatial;
                                        selected => {
                                            root.scene-form-changed();
                                        }
                                    }
                                }
                                Field {
                                    label: "Contrôle du bruit";
                                    ComboBox {
                                        model: root.scene-noise-choices;
                                        current-index <=> root.scene-noise;
                                        selected => {
                                            root.scene-form-changed();
                                        }
                                    }
                                }
                                Field {
                                    label: "Niveau (0 = ANC, 100 = transparence ; vide = inchangé)";
                                    LineEdit {
                                        text <=> root.scene-level;
                                        placeholder-text: "inchangé";
                                        edited => {
                                            root.scene-form-changed();
                                        }
                                    }
                                }
                                Field {
                                    label: "Anti-vent";
                                    ComboBox {
                                        model: root.scene-switch-choices;
                                        current-index <=> root.scene-anti-wind;
                                        selected => {
                                            root.scene-form-changed();
                                        }
                                    }
                                }
                                Field {
                                    label: "Commandes tactiles";
                                    ComboBox {
                                        model: root.scene-switch-choices;
                                        current-index <=> root.scene-touch;
                                        selected => {
                                            root.scene-form-changed();
                                        }
                                    }
                                }
                                Field {
                                    label: "Préréglage d'égaliseur";
                                    ComboBox {
                                        model: root.scene-eq-choices;
                                        current-index <=> root.scene-equalizer;
                                        selected => {
                                            root.scene-form-changed();
                                        }
                                    }
                                }
                                Field {
                                    label: "Amplification des basses";
                                    ComboBox {
                                        model: root.scene-switch-choices;
                                        current-index <=> root.scene-bass-boost;
                                        selected => {
                                            root.scene-form-changed();
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Montrer dans le panneau rapide (4 scènes au plus)";
                                        color: Theme.text;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Toggle {
                                            checked: root.scene-in-panel;
                                            accessible-label: "Montrer dans le panneau rapide";
                                            toggled(on) => {
                                                root.scene-in-panel = on;
                                                root.scene-panel-toggled(on);
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: root.scene-error != "" ? "⚠ " + root.scene-error : root.scene-preview;
                                    color: root.scene-error != "" ? Theme.danger : Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        if root.page == 5: HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            ActionButton {
                                icon: Icons.check;
                                text: "Enregistrer";
                                kind: root.scene-dirty ? "primary" : "secondary";
                                enabled: root.scene-can-save;
                                clicked => {
                                    root.scene-save();
                                }
                            }
                            ActionButton {
                                text: root.narrow ? "Annuler" : "Annuler les modifications";
                                kind: "ghost";
                                enabled: root.scene-dirty;
                                clicked => {
                                    root.confirm-scene-delete = false;
                                    root.scene-revert();
                                }
                            }
                            ActionButton {
                                icon: Icons.headphones;
                                text: root.narrow ? "Appliquer" : "Appliquer au casque";
                                enabled: root.scene-can-apply;
                                clicked => {
                                    root.scene-apply();
                                }
                            }
                        }
                        if root.page == 5: HorizontalLayout {
                            alignment: start;
                            ActionButton {
                                text: "Ouvrir scenes.txt";
                                kind: "ghost";
                                clicked => {
                                    root.open-scenes-file();
                                }
                            }
                        }
                        if root.page == 5: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 10px;
                                CardHeader {
                                    icon: Icons.sliders;
                                    title: "Panneau rapide";
                                }
                                Caption {
                                    text: "Ouvert d'un clic gauche sur l'icône. Enregistré aussitôt dans panneau.txt ; rien n'est envoyé au casque.";
                                }
                                for item[i] in ["Contrôle du bruit", "Curseur ANC ↔ transparence", "Profil personnalisé"]: HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: item;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Toggle {
                                            checked: i == 0 ? root.panel-show-noise : i == 1 ? root.panel-show-level : root.panel-show-profile;
                                            accessible-label: item;
                                            toggled(on) => {
                                                if i == 0 {
                                                    root.panel-show-noise = on;
                                                } else if i == 1 {
                                                    root.panel-show-level = on;
                                                } else {
                                                    root.panel-show-profile = on;
                                                }
                                                root.panel-sections-changed();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ───────────── Paramètres : casque, application ─────────────
            if root.section == 4: ScrollView {
                vertical-stretch: 1;
                HorizontalLayout {
                    padding: root.content-pad;
                    alignment: center;
                    VerticalLayout {
                        max-width: 1040px;
                        horizontal-stretch: 1;
                        spacing: Theme.gap;
                        alignment: start;
                        Segmented {
                            items: ["Casque", "Application"];
                            current: root.page == 2 ? 0 : 1;
                            selected(i) => {
                                root.page = i == 0 ? 2 : 6;
                            }
                        }

                        if root.page == 2 && !root.connected: EmptyState {
                            title: "Réglages du casque indisponibles";
                            text: root.waiting;
                        }
                        if root.page == 2 && root.connected: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 10px;
                                CardHeader {
                                    icon: Icons.pause;
                                    title: "Détection de port et appels";
                                }
                                ToggleRow {
                                    icon: Icons.pause;
                                    title: "Smart Pause";
                                    subtitle: "Pause quand on retire le casque";
                                    checked: root.smart-pause-on;
                                    enabled: root.smart-pause-enabled;
                                    busy: root.busy;
                                    toggled(on) => {
                                        root.smart-pause-toggled(on);
                                    }
                                }
                                ToggleRow {
                                    icon: Icons.phone;
                                    title: "Réponse automatique aux appels";
                                    subtitle: "En mettant le casque";
                                    checked: root.auto-answer-on;
                                    enabled: root.auto-answer-enabled;
                                    busy: root.busy;
                                    toggled(on) => {
                                        root.auto-answer-toggled(on);
                                    }
                                }
                                ToggleRow {
                                    icon: Icons.chat;
                                    title: "Appels confortables";
                                    subtitle: "Votre voix restituée pendant les appels";
                                    checked: root.comfort-on;
                                    enabled: root.comfort-enabled;
                                    busy: root.busy;
                                    toggled(on) => {
                                        root.comfort-toggled(on);
                                    }
                                }
                            }
                        }
                        if root.page == 2 && root.connected: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 10px;
                                CardHeader {
                                    icon: Icons.battery;
                                    title: "Alimentation";
                                }
                                SettingRow {
                                    icon: Icons.clock;
                                    title: "Extinction automatique";
                                    available: root.auto-off-enabled || root.auto-off >= 0;
                                    ComboBox {
                                        model: root.auto-off-labels;
                                        current-index <=> root.auto-off;
                                        enabled: root.auto-off-enabled;
                                        min-width: 160px;
                                        selected => {
                                            root.auto-off-selected(self.current-index);
                                        }
                                    }
                                }
                                ToggleRow {
                                    icon: Icons.shield;
                                    title: "Protection de la batterie";
                                    subtitle: "Charge limitée, plus lente";
                                    checked: root.battery-protection-on;
                                    enabled: root.battery-protection-enabled;
                                    busy: root.busy;
                                    toggled(on) => {
                                        root.battery-protection-toggled(on);
                                    }
                                }
                            }
                        }
                        if root.page == 2 && root.connected: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 12px;
                                CardHeader {
                                    icon: Icons.chat;
                                    title: "Invites audio et vocales";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    for mode[i] in root.prompt-modes: Chip {
                                        text: mode;
                                        horizontal-stretch: 1;
                                        selected: root.prompt-mode == i;
                                        enabled: root.prompts-enabled;
                                        clicked => {
                                            root.prompt-mode-clicked(i);
                                        }
                                    }
                                }
                                Field {
                                    label: "Volume des invites";
                                    HorizontalLayout {
                                        spacing: 12px;
                                        ThemedSlider {
                                            minimum: 0;
                                            maximum: 100;
                                            step: 1;
                                            value <=> root.prompt-volume;
                                            enabled: root.prompt-volume-enabled;
                                            accessible-label: "Volume des invites";
                                            released(v) => {
                                                root.prompt-volume-released(v);
                                            }
                                        }
                                        Text {
                                            text: root.prompt-volume < 0 ? "non lu" : round(root.prompt-volume) + " %";
                                            color: Theme.text;
                                            min-width: 56px;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        if root.page == 2 && root.connected: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 12px;
                                CardHeader {
                                    icon: Icons.pencil;
                                    title: "Nom du casque";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        placeholder-text: root.headset-name == "" ? "non lu" : root.headset-name;
                                        text <=> root.new-name;
                                        enabled: root.rename-enabled;
                                        horizontal-stretch: 1;
                                        accessible-label: "Nouveau nom du casque";
                                    }
                                    ActionButton {
                                        text: "Renommer";
                                        kind: "primary";
                                        enabled: root.rename-enabled && root.new-name != "";
                                        clicked => {
                                            root.rename(root.new-name);
                                            root.new-name = "";
                                        }
                                    }
                                }
                                Caption {
                                    text: "Lettres sans accent, chiffres et espaces, 32 caractères au plus. Le système et le téléphone peuvent garder l'ancien nom jusqu'à la prochaine connexion.";
                                }
                                RowList {
                                    rows: root.settings-info;
                                }
                                Caption {
                                    text: "Langue des invites et priorité du mode audio : lecture seule. Changer la priorité redémarre le casque et laisse souvent l'app du téléphone bloquée jusqu'à une extinction manuelle.";
                                }
                            }
                        }

                        if root.page == 6: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 10px;
                                CardHeader {
                                    icon: Theme.dark ? Icons.moon : Icons.sun;
                                    title: "Apparence";
                                }
                                ToggleRow {
                                    icon: Icons.moon;
                                    title: "Thème sombre";
                                    subtitle: "Le thème clair reprend les mêmes repères";
                                    checked: root.dark-theme;
                                    toggled(on) => {
                                        root.dark-theme = on;
                                        root.theme-changed(on);
                                    }
                                }
                            }
                        }
                        if root.page == 6: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 6px;
                                CardHeader {
                                    icon: Icons.info;
                                    title: "À propos";
                                }
                                RowList {
                                    rows: root.about-rows;
                                }
                            }
                        }
                        if root.page == 6: Card {
                            VerticalLayout {
                                padding: Theme.pad;
                                spacing: 12px;
                                CardHeader {
                                    icon: Icons.code;
                                    title: "Diagnostic";
                                }
                                Caption {
                                    text: "Texte à joindre à un rapport de bogue : versions, réglages lus ou non, incidents récents. Les noms, adresses Bluetooth, numéro de série, chemins personnels et le profil auditif en sont retirés. Relisez-le avant de le partager ; rien n'est envoyé.";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    ActionButton {
                                        text: "Préparer le diagnostic";
                                        kind: "primary";
                                        clicked => {
                                            root.diagnostic-copied = false;
                                            root.prepare-diagnostic();
                                        }
                                    }
                                    ActionButton {
                                        icon: root.diagnostic-copied ? Icons.check : "";
                                        text: root.diagnostic-copied ? "Copié" : "Copier";
                                        enabled: root.diagnostic != "";
                                        clicked => {
                                            diagnostic-text.select-all();
                                            diagnostic-text.copy();
                                            diagnostic-text.clear-selection();
                                            root.diagnostic-copied = true;
                                        }
                                    }
                                }
                                diagnostic-text := TextEdit {
                                    text: root.diagnostic;
                                    read-only: true;
                                    visible: root.diagnostic != "";
                                    height: root.diagnostic != "" ? 220px : 0px;
                                    font-size: 12px;
                                }
                            }
                        }
                        // Attribution exigée par la licence « royalty-free » de Slint.
                        if root.page == 6: AboutSlint {
                            vertical-stretch: 0;
                            max-height: 150px;
                        }
                    }
                }
            }

            // Navigation inférieure (petite fenêtre).
            if root.narrow: Rectangle {
                height: 68px;
                background: Theme.sidebar;
                Rectangle {
                    height: 1px;
                    y: 0px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    for name[i] in root.section-names: BottomTab {
                        icon: root.section-icons[i];
                        label: name;
                        selected: root.section == i;
                        clicked => {
                            root.go(i);
                        }
                    }
                }
            }
        }
    }
}
