// Égaliseur graphique : curseurs et panneau, au thème d'OpenHeadset Control.
//
// Le nombre de bandes, leurs fréquences et la plage de gain viennent du
// casque (lus par le worker), jamais de la maquette. Les gains sont en dB
// (le casque les transmet en dixièmes de dB, la conversion est faite côté
// Rust). Un gain n'est envoyé au casque qu'au relâchement du curseur ;
// l'état réel relu revient ensuite par `bands`.

import { Theme } from "theme.slint";
import { Toggle } from "widgets.slint";

export struct Band {
    label: string,
    gain: float,
}

// Curseur vertical : le remplissage part de 0 dB, avec un repère à 0 dB.
component EqSlider inherits Rectangle {
    in property <float> minimum: -6;
    in property <float> maximum: 6;
    in property <float> step: 0.5;
    in property <bool> enabled: true;
    in-out property <float> value;
    callback released(float);

    min-width: 26px;
    vertical-stretch: 1;
    accessible-role: slider;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;

    private property <length> thumb-size: 20px;
    private property <length> usable: root.height - root.thumb-size;

    // Position verticale (centre de la poignée) d'une valeur.
    pure function y-of(v: float) -> length {
        root.thumb-size / 2 + (root.maximum - v) / (root.maximum - root.minimum) * root.usable
    }

    // Valeur correspondant à une position, arrondie au pas et bornée.
    pure function value-at(y: length) -> float {
        let raw = root.maximum - (y - root.thumb-size / 2) / root.usable * (root.maximum - root.minimum);
        clamp(round(raw / root.step) * root.step, root.minimum, root.maximum)
    }

    // Piste.
    Rectangle {
        x: (root.width - 6px) / 2;
        y: root.thumb-size / 2;
        width: 6px;
        height: root.usable;
        border-radius: 3px;
        background: Theme.track;
    }

    // Remplissage entre 0 dB et la valeur.
    Rectangle {
        x: (root.width - 6px) / 2;
        y: min(root.y-of(0), root.y-of(root.value));
        width: 6px;
        height: abs(root.y-of(root.value) - root.y-of(0));
        border-radius: 3px;
        background: root.enabled ? @linear-gradient(180deg, Theme.accent-strong 0%, Theme.accent 100%) : Theme.border-strong;
        animate y, height { duration: Theme.quick; }
    }

    // Poignée.
    Rectangle {
        x: (root.width - root.thumb-size) / 2;
        y: root.y-of(root.value) - root.thumb-size / 2;
        width: root.thumb-size;
        height: root.thumb-size;
        border-radius: root.thumb-size / 2;
        background: #ffffff;
        // Contour en thème clair : une poignée blanche sur fond blanc
        // serait invisible.
        border-width: focus.has-focus ? 3px : Theme.dark ? 0px : 2px;
        border-color: Theme.accent;
        drop-shadow-blur: root.enabled ? 10px : 0px;
        drop-shadow-color: Theme.accent.with-alpha(0.6);
        opacity: root.enabled ? 1 : 0.6;
        animate y { duration: Theme.quick; }
    }

    // Clavier : flèches haut/bas d'un pas, Origine pour 0 dB.
    // Sous la zone tactile, et sans prise du clic : sinon le premier
    // clic ne ferait que donner le focus, sans rien envoyer au casque.
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.value = min(root.maximum, root.value + root.step);
                root.released(root.value);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.value = max(root.minimum, root.value - root.step);
                root.released(root.value);
                return accept;
            }
            if (event.text == Key.Home) {
                root.value = 0;
                root.released(root.value);
                return accept;
            }
            reject
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                focus.focus();
                root.value = root.value-at(self.mouse-y);
            } else if (event.kind == PointerEventKind.up) {
                root.released(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.value = root.value-at(self.mouse-y);
            }
        }
    }

}

// Gain affiché à la française : « −3,5 », « +1 », « 0 ».
global GainText {
    public pure function format(gain: float) -> string {
        let tenths = round(abs(gain) * 10);
        let sign = tenths == 0 ? "" : (gain > 0 ? "+" : "−");
        let decimal = mod(tenths, 10) == 0 ? "" : "," + mod(tenths, 10);
        sign + floor(tenths / 10) + decimal
    }
}

// Panneau d'égaliseur : bandes, axe en dB, basses et remise à plat.
export component EqualizerPanel inherits VerticalLayout {
    in property <[Band]> bands;
    in property <float> min-gain: -6;
    in property <float> max-gain: 6;
    in-out property <bool> bass-boost;
    in property <bool> enabled;
    in property <bool> busy;
    in property <string> status;
    // Affiche l'interrupteur des basses (pas sur l'Accueil).
    in property <bool> show-bass: true;

    callback band-released(int, float);
    callback bass-boost-toggled(bool);
    callback reset-flat();

    spacing: 10px;

    if root.status != "": Text {
        text: root.status;
        color: Theme.text-muted;
        font-size: Theme.font-small;
    }

    HorizontalLayout {
        vertical-stretch: 1;
        min-height: 220px;
        spacing: 8px;

        // Axe : maximum, 0 dB, minimum.
        VerticalLayout {
            width: 46px;
            padding-top: 18px;
            padding-bottom: 26px;
            Text {
                text: "+" + round(root.max-gain) + " dB";
                color: Theme.text-faint;
                font-size: 11px;
                horizontal-alignment: right;
            }
            Rectangle { vertical-stretch: 1; }
            Text {
                text: "0 dB";
                color: Theme.text-faint;
                font-size: 11px;
                horizontal-alignment: right;
            }
            Rectangle { vertical-stretch: 1; }
            Text {
                text: round(root.min-gain) + " dB";
                color: Theme.text-faint;
                font-size: 11px;
                horizontal-alignment: right;
            }
        }

        // Bandes : colonnes souples, qui suivent la largeur disponible.
        for band[i] in root.bands: VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            min-width: 26px;
            Text {
                text: GainText.format(slider.value);
                color: slider.value == 0 ? Theme.text-faint : Theme.accent-strong;
                horizontal-alignment: center;
                font-size: 11px;
                font-weight: 600;
            }
            slider := EqSlider {
                minimum: root.min-gain;
                maximum: root.max-gain;
                value: band.gain;
                enabled: root.enabled;
                accessible-label: band.label;
                released(value) => {
                    root.band-released(i, value);
                }
            }
            // « 325 Hz » passe sur deux lignes plutôt que d'être tronqué.
            Text {
                text: band.label;
                color: Theme.text-muted;
                horizontal-alignment: center;
                font-size: 12px;
                wrap: word-wrap;
                min-height: 30px;
            }
        }
    }

    if root.show-bass: HorizontalLayout {
        spacing: 12px;
        Text {
            text: "Amplification des basses";
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                checked: root.bass-boost;
                enabled: root.enabled;
                busy: root.busy;
                accessible-label: "Amplification des basses";
                toggled(on) => {
                    root.bass-boost-toggled(on);
                }
            }
        }
    }
}
