// Système de design d'OpenHeadset Control : couleurs (thèmes sombre et
// clair), rayons, espacements et icônes.
//
// Direction visuelle : fond bleu nuit presque noir, surfaces légèrement
// différenciées, accents bleus lumineux pour les sélections. Le thème
// sombre est celui par défaut ; le thème clair reprend les mêmes rôles.
//
// Icônes : tracés originaux du projet (grille 24 × 24, trait arrondi),
// sous la licence du dépôt (MIT OU Apache-2.0).

export global Theme {
    in-out property <bool> dark: true;

    // Fonds et surfaces.
    out property <color> background: dark ? #070b16 : #eef2f9;
    out property <color> background-glow: dark ? #0e2a63 : #d6e3fb;
    out property <color> sidebar: dark ? #0a1020 : #f7f9fd;
    out property <color> surface: dark ? #0f1628 : #ffffff;
    out property <color> surface-raised: dark ? #141d33 : #f3f6fc;
    out property <color> surface-hover: dark ? #1a2540 : #e8eef9;
    out property <color> border: dark ? #1e2a45 : #dbe3f0;
    out property <color> border-strong: dark ? #2a3a5e : #c3cfe3;

    // Textes.
    out property <color> text: dark ? #eef3ff : #0d1526;
    out property <color> text-muted: dark ? #8d9bb8 : #56637c;
    out property <color> text-faint: dark ? #5c6a86 : #8592a8;

    // Accent et états.
    out property <color> accent: dark ? #3b8bff : #1f6bf0;
    out property <color> accent-strong: dark ? #66a6ff : #1556d0;
    out property <color> accent-soft: dark ? #3b8bff29 : #1f6bf01f;
    out property <color> accent-text: #ffffff;
    out property <color> success: dark ? #34d27b : #138a4a;
    out property <color> warning: dark ? #f5b54a : #a86400;
    out property <color> danger: dark ? #ff6b6b : #c62828;
    out property <color> danger-soft: dark ? #ff6b6b22 : #c628281a;
    out property <color> warning-soft: dark ? #f5b54a1f : #a864001a;
    out property <color> shadow: dark ? #00000066 : #1b2a4a22;
    out property <color> track: dark ? #24314f : #d3dcec;

    // Formes et rythme.
    out property <length> radius-large: 18px;
    out property <length> radius: 14px;
    out property <length> radius-small: 10px;
    out property <length> gap: 16px;
    out property <length> pad: 20px;

    // Typographie.
    out property <length> font-title: 26px;
    out property <length> font-heading: 17px;
    out property <length> font-body: 14px;
    out property <length> font-small: 12px;

    // Durée des transitions (courtes et fluides).
    out property <duration> quick: 140ms;
    out property <duration> smooth: 220ms;
}

