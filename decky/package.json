{
  "name": "openheadset-control-decky",
  "version": "1.4.0",
  "description": "Extension Decky Loader d'OpenHeadset Control (mode jeu de Bazzite et du Steam Deck)",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@10.34.8",
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.16.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "4.65.0",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.8.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
